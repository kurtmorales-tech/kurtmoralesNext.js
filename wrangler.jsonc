{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "km-web-design",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-09",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "kurtmorales733@gmail.com"
    }
  ],
  // Durable lead log. Every inquiry is written here before the email is
  // attempted, so a mail failure can never lose a lead.
  "kv_namespaces": [
    {
      "binding": "LEADS",
      "id": "6e190b0067c045d3aaef08ad485c1cf5"
    }
  ],
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "kmwebdesign.xyz",
      "custom_domain": true
    },
    {
      "pattern": "www.kmwebdesign.xyz",
      "custom_domain": true
    }
  ]
}
